<Project>

  <!-- Invariant: shared package identity for every project in the repository. Only the five
       src\ projects are packable (samples and tests set IsPackable=false or are never
       packed); the metadata is harmless elsewhere. -->
  <PropertyGroup>
    <!-- Development placeholder. Released packages get their version from the Release workflow
         (.github/workflows/release.yml), which bumps the latest v* tag or takes an explicit
         version and passes it to dotnet pack as -p:Version. -->
    <Version>0.0.0-dev</Version>
    <Authors>auroris</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/auroris/Interactive-Reports</PackageProjectUrl>
    <RepositoryUrl>https://github.com/auroris/Interactive-Reports</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>reporting;interactive-report;apex;grid;sql;aspnetcore;umbraco</PackageTags>

    <!-- Source Link: the .NET 8+ SDK embeds GitHub source-link support natively. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Use configured NuGet feeds instead of the SDK's optional library-packs directory. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Comment readability outranks XML-doc pedantry: no exhaustive coverage (CS1591/CS1573),
         and prose like "comparison = <> < <=" stays literal rather than entity-escaped
         (CS1570). -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1570</NoWarn>
  </PropertyGroup>

</Project>
